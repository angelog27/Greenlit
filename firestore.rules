rules_version = '2';
// Only the Cloud Functions (Admin SDK, which bypasses these rules) write scores and campaigns.
// Boards are public to read; a player's own run history is readable only by them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{board} {
      allow read: if true;
      allow write: if false;
      match /entries/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Campaign: the studio and its films are readable by their owner only; the board is public. Only the
    // campaign* Cloud Functions write either.
    match /campaigns/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      match /films/{film} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /campaignBoard/{uid} {
      allow read: if true;
      allow write: if false;
    }
    // Greenlight Globes weeks, their results and the submitted films are public; only the functions write.
    match /awards/{week} {
      allow read: if true;
      allow write: if false;
      match /entries/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }
    // Public studio cards (look, level, badges, best film), written by the functions only.
    match /studios/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
