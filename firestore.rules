rules_version = '2';
// Only the release Cloud Function (Admin SDK, which bypasses these rules) writes scores.
// Boards are public to read; a player's own run history is readable only by them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{board} {
      allow read: if true;
      allow write: if false;
      match /entries/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
